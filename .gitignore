# Python
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual Environment
venv/
env/
ENV/

# IDE
.vscode/
.idea/
*.swp
*.swo

# Logs
*.log
logs/
DEBUG*.log

# Database files
*.db
*.db-shm
*.db-wal

# Tracking files
*.lock



# History files
B20SS/.history/

# Temporary files
.import_cache.db

# Python packaging build artifacts (story C11a).
# `python -m build` writes build/ and *.egg-info/; an editable install writes
# egg-info too. They are generated copies of the source tree -- committing them
# doubles the repo and guarantees they go stale.
build/
dist/
*.egg-info/

# Test reports written into the working directory by the legacy CLI test
# suites (story C14). Every suite under Tests/ that inherits the old reporting
# base drops a *_test_report_<timestamp>.txt and *_test_results_<id>.json
# wherever it was run from, so running them in CI would otherwise dirty the
# tree. The runner's own output is on stdout.
*_test_report_*.txt
*_test_results_*.json
